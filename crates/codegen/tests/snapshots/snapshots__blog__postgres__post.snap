pub fn author_none(
    f: ::ruprizzle::Filter<super::user::User>,
) -> ::ruprizzle::Filter<Post> {
    ::ruprizzle::Filter::new(::ruprizzle::FilterNode::Exists {
        child_table: "users",
        child_col: "id",
        parent_table: "posts",
        parent_col: "author_id",
        filter: Box::new(f.node),
        negated: true,
    })
}
/// Returns a filter for parents where every matching child satisfies `f`.
/// Vacuously true for parents with no children.
pub fn author_every(
    f: ::ruprizzle::Filter<super::user::User>,
) -> ::ruprizzle::Filter<Post> {
    ::ruprizzle::Filter::new(::ruprizzle::FilterNode::Exists {
        child_table: "users",
        child_col: "id",
        parent_table: "posts",
        parent_col: "author_id",
        filter: Box::new((!f).node),
        negated: true,
    })
}
/// Prisma-flavoured repository for `#model_name`.
#[derive(Debug, Clone, Copy)]
pub struct PostRepo<'a> {
    db: &'a super::Db,
}
impl<'a> PostRepo<'a> {
    /// Creates a new repository handle.
    pub(crate) fn new(db: &'a super::Db) -> Self {
        Self { db }
    }
    /// Start a `find_many` query.
    pub fn find_many(&self) -> ::ruprizzle::SelectQuery<'a, Post> {
        ::ruprizzle::SelectQuery::new(self.db.raw_pool())
    }
    /// Start an `insert` query.
    pub fn create(&self, _data: PostInsert) -> ::ruprizzle::InsertQuery<'a, Post> {
        let mut insert = ::ruprizzle::InsertQuery::new(self.db.raw_pool());
        insert = insert.set_optional(ID, _data.id);
        insert = insert.set(TITLE, _data.title);
        insert = insert.set_optional(BODY, _data.body);
        insert = insert.set_optional(PUBLISHED, _data.published);
        insert = insert.set(AUTHOR_ID, _data.author_id);
        insert = insert.set_optional(CREATED_AT, _data.created_at);
        insert
    }
    /// Start a multi-row `insert` query.
    pub fn create_many(
        &self,
        _data: Vec<PostInsert>,
    ) -> ::ruprizzle::InsertManyQuery<'a, Post> {
        let mut q = ::ruprizzle::InsertManyQuery::new(self.db.raw_pool());
        for _row in _data {
            q = q
                .row([
                    ("id", ::ruprizzle::Encodable::to_value(&_row.id)),
                    ("title", ::ruprizzle::Encodable::to_value(&_row.title)),
                    ("body", ::ruprizzle::Encodable::to_value(&_row.body)),
                    ("published", ::ruprizzle::Encodable::to_value(&_row.published)),
                    ("author_id", ::ruprizzle::Encodable::to_value(&_row.author_id)),
                    ("created_at", ::ruprizzle::Encodable::to_value(&_row.created_at)),
                ]);
        }
        q
    }
    /// Start an `update` query.
    pub fn update(&self) -> ::ruprizzle::UpdateQuery<'a, Post> {
        ::ruprizzle::UpdateQuery::new(self.db.raw_pool())
    }
    /// Start a `delete` query.
    pub fn delete(&self) -> ::ruprizzle::DeleteQuery<'a, Post> {
        ::ruprizzle::DeleteQuery::new(self.db.raw_pool())
    }
}
