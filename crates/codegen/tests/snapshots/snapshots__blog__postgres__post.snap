/// Returns an `IncludeOne` for this relation.
pub fn author() -> ::ruprizzle::IncludeOne<'static, Post, super::user::User, Uuid, ()> {
    ::ruprizzle::IncludeOne::new(
        |__row| __row.author_id,
        |__row, __loaded| __row.author = __loaded,
        super::user::ID,
        |__child| __child.id,
    )
}
/// Returns a filter for parents that have at least one matching child.
pub fn author_some(
    f: ::ruprizzle::Filter<super::user::User>,
) -> ::ruprizzle::Filter<Post> {
    ::ruprizzle::Filter::new(::ruprizzle::FilterNode::Exists {
        child_table: "users",
        child_col: "id",
        parent_table: "posts",
        parent_col: "author_id",
        filter: Box::new(f.node),
        negated: false,
    })
}
