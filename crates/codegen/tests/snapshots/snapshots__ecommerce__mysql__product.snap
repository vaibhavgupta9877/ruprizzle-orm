    pub fn create(&self, _data: ProductInsert) -> ::ruprizzle::InsertQuery<'a, Product> {
        let mut insert = ::ruprizzle::InsertQuery::new(self.db.raw_pool());
        insert = insert.set_optional(ID, _data.id);
        insert = insert.set(SKU, _data.sku);
        insert = insert.set(NAME, _data.name);
        insert = insert.set(PRICE, _data.price);
        insert
