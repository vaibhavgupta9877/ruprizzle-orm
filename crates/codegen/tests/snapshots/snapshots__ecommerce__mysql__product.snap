    /// Start a multi-row `insert` query.
    pub fn create_many(
        &self,
        _data: Vec<ProductInsert>,
    ) -> ::ruprizzle::InsertManyQuery<'a, Product> {
        let mut q = ::ruprizzle::InsertManyQuery::new(self.db.raw_pool());
        for _row in _data {
            q = q
                .row([
                    ("id", ::ruprizzle::Encodable::to_value(&_row.id)),
                    ("sku", ::ruprizzle::Encodable::to_value(&_row.sku)),
                    ("name", ::ruprizzle::Encodable::to_value(&_row.name)),
                    ("price", ::ruprizzle::Encodable::to_value(&_row.price)),
                ]);
        }
        q
    }
