pub const TABLE: &str = "products";
pub const ID: Column<Product, Uuid> = Column::new("products", "id");
pub const SKU: Column<Product, String> = Column::new("products", "sku");
pub const NAME: Column<Product, String> = Column::new("products", "name");
pub const PRICE: Column<Product, Decimal> = Column::new("products", "price");
/// Returns an `IncludeList` for this relation.
pub fn items() -> ::ruprizzle::IncludeList<
    'static,
    Product,
    super::order_item::OrderItem,
    Uuid,
    (),
> {
    ::ruprizzle::IncludeList::new(
        |__row| __row.id,
        |__row, __loaded| __row.items = __loaded,
        super::order_item::PRODUCT_ID,
        |__child| __child.product_id,
    )
}
