pub fn items_some(
    f: ::ruprizzle::Filter<super::order_item::OrderItem>,
) -> ::ruprizzle::Filter<Product> {
    ::ruprizzle::Filter::new(::ruprizzle::FilterNode::Exists {
        child_table: "order_items",
        child_col: "product_id",
        parent_table: "products",
        parent_col: "id",
