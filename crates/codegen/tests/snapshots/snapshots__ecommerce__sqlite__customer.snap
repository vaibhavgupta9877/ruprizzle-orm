        let mut insert = ::ruprizzle::InsertQuery::new(self.db.raw_pool());
        insert = insert.set_optional(ID, _data.id);
        insert = insert.set(EMAIL, _data.email);
        insert = insert.set(NAME, _data.name);
        insert = insert.set_optional(CREATED_AT, _data.created_at);
        insert
