/// Table name for this model.
pub const TABLE: &str = "customers";
pub const ID: Column<Customer, Uuid> = Column::new("customers", "id");
pub const EMAIL: Column<Customer, String> = Column::new("customers", "email");
pub const NAME: Column<Customer, String> = Column::new("customers", "name");
pub const CREATED_AT: Column<Customer, DateTime<Utc>> = Column::new(
    "customers",
    "created_at",
);
/// Returns an `IncludeList` for this relation.
pub fn orders() -> ::ruprizzle::IncludeList<
    'static,
    Customer,
    super::order::Order,
    Uuid,
    (),
> {
    ::ruprizzle::IncludeList::new(
        |__row| __row.id,
        |__row, __loaded| __row.orders = __loaded,
        super::order::CUSTOMER_ID,
        |__child| __child.customer_id,
    )
}
