///Returns a query for the `posts` many-to-many relation.
pub fn posts<'__a>(
    __exec: &'__a dyn ::ruprizzle::Executor,
    id: i32,
) -> ::ruprizzle::SelectQuery<'__a, super::tag::Tag> {
    let __subquery = ::ruprizzle::SelectQuery::new(__exec)
        .filter(super::post_tag::POST_ID.eq(id))
        .columns(super::post_tag::TAG_ID);
    ::ruprizzle::SelectQuery::new(__exec).filter(super::tag::ID.in_subquery(__subquery))
}
