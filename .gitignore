/target
**/target/
**/*.rs.bk
*.pdb
/local/cross-orm-bench/rust/*/Cargo.lock
__pycache__/

# Local configuration and secrets
.env
.env.*
!.env.example

# Snapshot review artefacts
**/*.snap.new

# SQLite databases created by local experiments
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Per-harness result files are regenerated by the benchmark runner
/local/cross-orm-bench/rust/*-bench/*-results.json

# Transient test directories created by tempfile under local/deep-tests/db
local/deep-tests/db/.tmp*/

# Proptest regression artefacts
*.proptest-regressions

# Local cargo-deny database and config
/.cargo/*
!/.cargo/mutants.toml

# Private project planning notes (not published to GitHub)
/docs/superpowers/

# Transient output of `cargo xtask bench-client`
/crates/runtime/benches/end_to_end/generated

# Generated coverage reports (kept in working tree, not committed)
/local/coverage/

# cargo-mutants output
/mutants.out
/mutants.out.old

# Isolated dev worktrees
/.worktrees/
