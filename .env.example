# Copy to `.env` for local development.
#
# The test harness reads RUPRIZZLE_TEST_PG_URL first, then DATABASE_URL, then
# falls back to the docker-compose defaults below.
DATABASE_URL=postgres://ruprizzle:ruprizzle@localhost:5432/ruprizzle_test
RUPRIZZLE_TEST_PG_URL=postgres://ruprizzle:ruprizzle@localhost:5432/ruprizzle_test
