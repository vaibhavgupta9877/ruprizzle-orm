{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ruprizzle",
  "scopeName": "source.ruprizzle",
  "fileTypes": [".ruprizzle"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#attribute" },
    { "include": "#block" },
    { "include": "#keyword" },
    { "include": "#type" },
    { "include": "#function" },
    { "include": "#relation" },
    { "include": "#map" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ruprizzle",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ruprizzle",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.ruprizzle",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ruprizzle",
          "match": "\\\\."
        }
      ]
    },
    "number": {
      "name": "constant.numeric.ruprizzle",
      "match": "\\b\\d+\\b"
    },
    "attribute": {
      "name": "entity.other.attribute-name.ruprizzle",
      "match": "@[A-Za-z][A-Za-z0-9_]*"
    },
    "block": {
      "patterns": [
        {
          "name": "keyword.control.block.ruprizzle",
          "match": "\\b(datasource|generator|model|enum)\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.other.ruprizzle",
          "match": "\\b(true|false|env|autoincrement|now|uuid7|Cascade|Restrict|SetNull|SetDefault|NoAction)\\b"
        }
      ]
    },
    "type": {
      "name": "storage.type.ruprizzle",
      "match": "\\b(String|Int|BigInt|Float|Decimal|Boolean|DateTime|Date|Time|Uuid|Json|Bytes)\\b"
    },
    "function": {
      "name": "entity.name.function.ruprizzle",
      "match": "\\b(default|unique|id|relation|map|ignore|index)\\b(?=\\s*\\()"
    },
    "relation": {
      "name": "keyword.control.relation.ruprizzle",
      "match": "\\b(fields|references|onDelete|onUpdate)\\b"
    },
    "map": {
      "name": "support.function.map.ruprizzle",
      "match": "@@?(map|unique|index|id)"
    }
  }
}
