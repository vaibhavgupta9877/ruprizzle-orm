{
  "name": "vscode-ruprizzle",
  "displayName": "ruprizzle",
  "description": "Language support, syntax highlighting, formatting, and LSP 2.0 for ruprizzle schema files",
  "version": "1.2.0",
  "publisher": "ruprizzle",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:ruprizzle"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ruprizzle",
        "aliases": [
          "ruprizzle",
          "schema.ruprizzle"
        ],
        "extensions": [
          ".ruprizzle"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ruprizzle",
        "scopeName": "source.ruprizzle",
        "path": "../ruprizzle.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "ruprizzle",
      "properties": {
        "ruprizzle.languageServer.path": {
          "type": "string",
          "default": "ruprizzle",
          "description": "Path to the ruprizzle language server executable."
        },
        "ruprizzle.lsp.path": {
          "type": "string",
          "default": "ruprizzle",
          "description": "Custom binary path for the Ruprizzle Language Server."
        },
        "ruprizzle.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the ruprizzle language server."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.0.0"
  }
}

