generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../bench.sqlite3"
}

model User {
  id    Int    @id
  email String
  age   Int
  posts Post[]

  @@map("users")
}

model Post {
  id       Int    @id
  authorId Int    @map("author_id")
  title    String
  author   User   @relation(fields: [authorId], references: [id])

  @@map("posts")
}

model BenchBulk {
  id   Int    @id
  name String
  n    Int

  @@map("bench_bulk")
}
