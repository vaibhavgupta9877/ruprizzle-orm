<meta name="author" content="Vaibhav Gupta">
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large">

<!--
  Per-page tags are intentionally NOT set here. mdBook renders this partial
  with the same context on every page, so a `description`, `canonical`,
  `og:url` or `og:title` built from `{{ base_url }}`/`{{ book_title }}` would
  be identical everywhere — a canonical would ask search engines to drop the
  whole book bar the index, and a duplicated description wastes each page's
  snippet. `scripts/postprocess-docs.sh` injects the correct per-page values
  after `mdbook build` (the `description` meta it rewrites is emitted by
  mdBook itself from book.toml's `description`); see that script and
  `.github/workflows/pages.yml`.
-->

<meta property="og:site_name" content="ruprizzle-orm">
<meta property="og:type" content="website">
<meta property="og:locale" content="en">

<meta name="twitter:card" content="summary">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "ruprizzle-orm",
      "url": "{{ base_url }}",
      "sameAs": [
        "https://github.com/vaibhavgupta9877/ruprizzle-orm",
        "https://crates.io/crates/ruprizzle",
        "https://docs.rs/ruprizzle"
      ]
    },
    {
      "@type": "WebSite",
      "name": "ruprizzle-orm Documentation",
      "url": "{{ base_url }}",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ base_url }}?search={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "SoftwareSourceCode",
      "name": "ruprizzle",
      "description": "A schema-first ORM for Rust. A Prisma-style schema file generates a typed client, with Drizzle-style SQL transparency and no sidecar binary. Supports PostgreSQL, MySQL/MariaDB and SQLite.",
      "softwareVersion": "1.5.1",
      "programmingLanguage": "Rust",
      "runtimePlatform": "Rust",
      "codeRepository": "https://github.com/vaibhavgupta9877/ruprizzle-orm",
      "license": "https://spdx.org/licenses/MIT.html",
      "author": {
        "@type": "Person",
        "name": "Vaibhav Gupta"
      }
    }
  ]
}
</script>
